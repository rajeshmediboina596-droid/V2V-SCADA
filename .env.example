# ==============================================================================
# V2V-SCADA Safety & Highway Monitoring System - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Operational Mode
# ------------------------------------------------------------------------------
# Options: 'development', 'test', 'production'
ENVIRONMENT=development

# DEMO_MODE: Set to 'true' for local university / evaluation demonstrations.
# Set to 'false' in production environments to enforce strict anti-replay validation.
DEMO_MODE=true

# ------------------------------------------------------------------------------
# 2. Cryptographic Security & Anti-Replay
# ------------------------------------------------------------------------------
# IMPORTANT: In production, generate a strong random 256-bit secret.
# Example: openssl rand -hex 32
# If running in production mode, startup will fail safely if this is left default.
HMAC_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# Maximum permissible divergence between packet timestamp and host clock (seconds)
REPLAY_TOLERANCE_SECONDS=30

# Maximum number of vehicle IDs tracked in memory for sequence anti-replay
MAX_TRACKED_VEHICLES=1000

# ------------------------------------------------------------------------------
# 3. CORS & Web Security
# ------------------------------------------------------------------------------
# Comma-separated list of trusted origins for HTTP/WebSocket clients
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 4. MQTT Broker & Transport Security
# ------------------------------------------------------------------------------
# Security mode: 'demo' (anonymous/local broker) or 'secure' (authenticated TLS)
MQTT_SECURITY_MODE=demo

MQTT_BROKER=localhost
MQTT_PORT=1883

# Credentials for 'secure' mode (leave empty for 'demo' mode)
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_CA_CERT=mqtt/certs/ca.crt
MQTT_CLIENT_CERT=mqtt/certs/client.crt
MQTT_CLIENT_KEY=mqtt/certs/client.key

MQTT_TOPIC_TELEMETRY=v2v/telemetry
MQTT_TOPIC_ALERTS=v2v/alerts/#
MQTT_TOPIC_COMMANDS=v2v/commands
MQTT_TOPIC_GATEWAY=v2v/gateway/health

# ------------------------------------------------------------------------------
# 5. Hardware STM32 Gateway Serial Interface
# ------------------------------------------------------------------------------
# Windows: COM3, COM4 | Linux/Raspberry Pi: /dev/ttyUSB0
SERIAL_PORT=COM3
SERIAL_BAUDRATE=115200

# ------------------------------------------------------------------------------
# 6. SQLite Database & Storage
# ------------------------------------------------------------------------------
DB_PATH=database/v2v_data.db

# ------------------------------------------------------------------------------
# 7. FastAPI Server Settings
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 8. Optional Multi-Indian-Language Voice Call & Telephony Providers
# ------------------------------------------------------------------------------
# STT_PROVIDER: 'browser_speech' (Zero-dep Web Speech API), 'mock', 'google', 'whisper'
STT_PROVIDER=browser_speech

# TRANSLATION_PROVIDER: 'hybrid' (Offline Lexicon + Neural API), 'lexicon_only', 'online_only', 'mock'
TRANSLATION_PROVIDER=hybrid

# TTS_PROVIDER: 'browser_speech' (Browser SpeechSynthesis), 'mock', 'gtts'
TTS_PROVIDER=browser_speech

# TELEPHONY_PROVIDER: 'webrtc_scada' (WebRTC In-Browser Duplex), 'mock', 'twilio', 'sip'
TELEPHONY_PROVIDER=webrtc_scada

# Optional Twilio Telephony Credentials (isolated behind provider interface)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+10000000000

# Default Languages for Emergency Voice Call (12 Indian Languages Supported)
DEFAULT_DRIVER_LANG=te
DEFAULT_OPERATOR_LANG=hi

# ==============================================================================
# V2V SCADA & Safety Monitoring System - Environment Configuration
# ==============================================================================

# Cryptography & Security
HMAC_SECRET=v2v_shared_secret_123
REPLAY_TOLERANCE_SECONDS=30

# Local MQTT Broker (Eclipse Mosquitto)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_TELEMETRY=v2v/telemetry
MQTT_TOPIC_ALERTS=v2v/alerts/#
MQTT_TOPIC_COMMANDS=v2v/commands
MQTT_TOPIC_GATEWAY=v2v/gateway/health

# Hardware STM32 Gateway Serial Interface
# Windows: COM3, COM4 | Linux/Raspberry Pi: /dev/ttyUSB0
SERIAL_PORT=COM3
SERIAL_BAUDRATE=115200

# SQLite Database Location
DB_PATH=database/v2v_data.db

# FastAPI Server Port
PORT=8000
HOST=0.0.0.0

# ==============================================================================
# Real-Time Multi-Indian-Language Voice Call & Telephony Providers
# ==============================================================================
# STT_PROVIDER options: 'browser_speech' (Zero-dep Web Speech API), 'mock', 'google', 'whisper'
STT_PROVIDER=browser_speech

# TRANSLATION_PROVIDER options: 'hybrid' (Offline Lexicon + Neural API), 'lexicon_only', 'online_only', 'mock'
TRANSLATION_PROVIDER=hybrid

# TTS_PROVIDER options: 'browser_speech' (Browser SpeechSynthesis), 'mock', 'gtts'
TTS_PROVIDER=browser_speech

# TELEPHONY_PROVIDER options: 'webrtc_scada' (WebRTC In-Browser Duplex), 'mock', 'twilio', 'sip'
TELEPHONY_PROVIDER=webrtc_scada

# External Telephony Credentials (Optional - isolated behind provider interface)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+10000000000

# Default Languages for Emergency Voice Call (12 Indian Languages Supported)
DEFAULT_DRIVER_LANG=te
DEFAULT_OPERATOR_LANG=hi
